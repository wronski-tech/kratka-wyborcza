# Skopiuj do `.env` w katalogu projektu (`cp .env.example .env`) i uzupełnij.
# Docker Compose wczytuje `.env` automatycznie.

OPENAI_API_KEY=
# Cheap model writes the SQL first; the stronger one repairs a failed query.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_REPAIR_MODEL=gpt-4o
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Password of the read-only role for LLM-generated SQL (used by the api and the loader).
# MART_READER_PASSWORD=
# "production" refuses to start with default passwords or a disabled rate limit.
# PLUJKA_ENV=development
# POST /ask requests per minute and client IP (0 = unlimited).
# ASK_RATE_LIMIT_PER_MINUTE=30
# Shared rate limit across API workers (start Redis with: docker compose --profile redis up -d).
# REDIS_URL=redis://redis:6379/0
# OpenAI tokens per API key or client IP and UTC day for POST /ask (0 = unlimited).
# DAILY_TOKEN_LIMIT_PER_CLIENT=0
# Comma-separated API keys; when set, POST /ask and /feedback require the X-API-Key header.
# API_KEYS=
# Keys that may read the cost panel (GET /costs, ?panel=koszty in the UI); not the UI's key.
# ADMIN_API_KEYS=
# USD per million tokens [input, cached input, output] per model for the cost estimate.
# LLM_PRICES_USD_PER_1M={"gpt-4o-mini": [0.15, 0.075, 0.6], "gpt-4o": [2.5, 1.25, 10.0]}
# Key the Streamlit UI sends to the API (one of API_KEYS).
# PLUJKA_API_KEY=
