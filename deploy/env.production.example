# /srv/plujka/.env on the production server (chmod 600, owner deploy). Never commit the real file.
# Generate passwords with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
MART_READER_PASSWORD=
OPENAI_API_KEY=
# The UI calls the API server-side: give it one of API_KEYS.
API_KEYS=
PLUJKA_API_KEY=
# Cost panel (GET /costs, ?panel=koszty): a key of its own, never the UI's PLUJKA_API_KEY.
ADMIN_API_KEYS=
# Two uvicorn workers share the limits through Redis (started by deploy/docker-compose.prod.yml).
REDIS_URL=redis://redis:6379/0
# The UI shares one bucket (PLUJKA_API_KEY): size both limits for all UI users together.
ASK_RATE_LIMIT_PER_MINUTE=120
DAILY_TOKEN_LIMIT_PER_CLIENT=200000
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
# Grafana's admin user (dashboard "Kratka Wyborcza", through an SSH tunnel: docs/DEPLOYMENT.md, Metrics).
GRAFANA_ADMIN_PASSWORD=
# Slack-compatible incoming webhook for alerts (Slack, Mattermost, Discord + /slack): docs/DEPLOYMENT.md, Alerts.
ALERT_WEBHOOK_SECRET=
# Error tracking: a Sentry or GlitchTip project DSN (docs/DEPLOYMENT.md, Error tracking); empty turns it off.
SENTRY_DSN=
