# Nightly backup of the public schema to the Storage Box (deploy/backup_storagebox.sh).
# Installed by cloud-init; on an older server: sudo cp deploy/systemd/plujka-backup.* /etc/systemd/system/
# && sudo systemctl daemon-reload && sudo systemctl enable --now plujka-backup.timer
[Unit]
Description=Kratka Wyborcza backup to the Storage Box
After=plujka.service
Requires=docker.service
# Waits for the operator's Storage Box setup (docs/DEPLOYMENT.md, "Nightly backup to the Storage Box").
ConditionPathExists=/srv/plujka/deploy/backup.env

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/plujka
EnvironmentFile=/srv/plujka/deploy/backup.env
ExecStart=/srv/plujka/deploy/backup_storagebox.sh
