#cloud-config
# First boot of the Kratka Wyborcza server: Docker, the data volume on /mnt/data, the repository in
# /srv/kratka-wyborcza and the systemd units of deploy/systemd: the stack starts once .env exists (secrets
# are copied by the operator, never stored in Terraform or Git). See infra/hetzner/README.md.
disable_root: true
ssh_pwauth: false

# Created before the users, so deploy can join it before docker.io is installed.
groups:
  - docker

users:
  - name: deploy
    groups: [docker, sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-v2
  - git
  - jq
  - age
  - fail2ban
  - unattended-upgrades

write_files:
  # Container logs rotate at 5 x 20 MB each; Loki keeps 30 days of them (docs/DEPLOYMENT.md, Logs).
  - path: /etc/docker/daemon.json
    content: |
      {"log-driver": "json-file", "log-opts": {"max-size": "20m", "max-file": "5"}}
  - path: /etc/sysctl.d/90-opensearch.conf
    content: |
      vm.max_map_count=262144
  - path: /etc/systemd/system/mnt-data.mount
    content: |
      [Unit]
      Description=Kratka Wyborcza data volume

      [Mount]
      What=/dev/disk/by-id/scsi-0HC_Volume_${volume_id}
      Where=/mnt/data
      Type=ext4
      Options=defaults,discard

      [Install]
      WantedBy=multi-user.target

runcmd:
  - sysctl --system
  - systemctl daemon-reload
  # The volume is attached right after the server is created; wait for it before mounting.
  - timeout 600 sh -c 'until [ -e /dev/disk/by-id/scsi-0HC_Volume_${volume_id} ]; do sleep 2; done' || exit 1
  - systemctl enable --now mnt-data.mount || exit 1
  - mkdir -p /mnt/data/postgres /mnt/data/opensearch /mnt/data/feedback /mnt/data/caddy /mnt/data/backups /mnt/data/prometheus /mnt/data/grafana /mnt/data/loki
  - chown 1000:1000 /mnt/data/opensearch
  - chown 65534:65534 /mnt/data/prometheus
  - chown 472:0 /mnt/data/grafana
  - chown 10001:10001 /mnt/data/loki
  - git clone --branch ${git_ref} ${repo_url} /srv/kratka-wyborcza
  - printf 'DOMAIN=%s\nACME_EMAIL=%s\n' '${domain}' '${acme_email}' > /srv/kratka-wyborcza/deploy/caddy.env
  - chown -R deploy:deploy /srv/kratka-wyborcza
  # The stack starts once .env exists; the nightly backup waits for deploy/backup.env (docs/DEPLOYMENT.md).
  - cp /srv/kratka-wyborcza/deploy/systemd/kratka-wyborcza.service /srv/kratka-wyborcza/deploy/systemd/kratka-wyborcza-backup.service /srv/kratka-wyborcza/deploy/systemd/kratka-wyborcza-backup.timer /etc/systemd/system/
  - systemctl daemon-reload
  - systemctl enable kratka-wyborcza-backup.timer
  - systemctl enable kratka-wyborcza.service
  - systemctl enable --now unattended-upgrades fail2ban
