#cloud-config
# First boot of the Kratka Wyborcza server: Docker, the data volume on /mnt/data, the repository in
# /srv/plujka and a systemd unit that starts the stack once /srv/plujka/.env exists (secrets are
# copied by the operator, never stored in Terraform or Git). See infra/hetzner/README.md.
disable_root: true
ssh_pwauth: false

# Created before the users, so deploy can join it before docker.io is installed.
groups:
  - docker

users:
  - name: deploy
    groups: [docker, sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-v2
  - git
  - jq
  - age
  - fail2ban
  - unattended-upgrades

write_files:
  # Container logs rotate at 5 x 20 MB each; Loki keeps 30 days of them (docs/DEPLOYMENT.md, Logs).
  - path: /etc/docker/daemon.json
    content: |
      {"log-driver": "json-file", "log-opts": {"max-size": "20m", "max-file": "5"}}
  - path: /etc/sysctl.d/90-opensearch.conf
    content: |
      vm.max_map_count=262144
  - path: /etc/systemd/system/plujka.service
    content: |
      [Unit]
      Description=Kratka Wyborcza (docker compose)
      After=docker.service mnt-data.mount
      Requires=docker.service mnt-data.mount
      ConditionPathExists=/srv/plujka/.env

      [Service]
      Type=oneshot
      RemainAfterExit=true
      WorkingDirectory=/srv/plujka
      ExecStart=/usr/bin/docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d --remove-orphans
      ExecStop=/usr/bin/docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml stop
      TimeoutStartSec=1800

      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/mnt-data.mount
    content: |
      [Unit]
      Description=Kratka Wyborcza data volume

      [Mount]
      What=/dev/disk/by-id/scsi-0HC_Volume_${volume_id}
      Where=/mnt/data
      Type=ext4
      Options=defaults,discard

      [Install]
      WantedBy=multi-user.target

runcmd:
  - sysctl --system
  - systemctl daemon-reload
  # The volume is attached right after the server is created; wait for it before mounting.
  - timeout 600 sh -c 'until [ -e /dev/disk/by-id/scsi-0HC_Volume_${volume_id} ]; do sleep 2; done' || exit 1
  - systemctl enable --now mnt-data.mount || exit 1
  - mkdir -p /mnt/data/postgres /mnt/data/opensearch /mnt/data/feedback /mnt/data/caddy /mnt/data/backups /mnt/data/prometheus /mnt/data/grafana /mnt/data/loki
  - chown 1000:1000 /mnt/data/opensearch
  - chown 65534:65534 /mnt/data/prometheus
  - chown 472:0 /mnt/data/grafana
  - chown 10001:10001 /mnt/data/loki
  - git clone --branch ${git_ref} ${repo_url} /srv/plujka
  - printf 'DOMAIN=%s\nACME_EMAIL=%s\n' '${domain}' '${acme_email}' > /srv/plujka/deploy/caddy.env
  - chown -R deploy:deploy /srv/plujka
  # Nightly backup to the Storage Box; it waits for deploy/backup.env (docs/DEPLOYMENT.md).
  - cp /srv/plujka/deploy/systemd/plujka-backup.service /srv/plujka/deploy/systemd/plujka-backup.timer /etc/systemd/system/
  - systemctl daemon-reload
  - systemctl enable plujka-backup.timer
  - systemctl enable plujka.service
  - systemctl enable --now unattended-upgrades fail2ban
